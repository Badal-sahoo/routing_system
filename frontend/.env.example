# Copy this file to .env and adjust if your backend is not on localhost:8000:
#
#     cp .env.example .env
#
# Vite only exposes variables that start with VITE_, and it inlines them at
# build time -- restart `npm run dev` after changing anything here.

# Backend REST API. The trailing slash matters (axios joins paths onto it).
VITE_API_URL=http://127.0.0.1:8000/api/

# Live GPS WebSocket endpoint.
VITE_WS_URL=ws://127.0.0.1:8000/ws/fleet/

# How long to wait before reconnecting a dropped WebSocket (ms).
VITE_WS_RECONNECT_DELAY_MS=2000

# How long to wait for the Celery worker before refetching tasks after a
# dispatch (ms). Task status is not pushed over WebSocket, only GPS is.
VITE_TASK_REFRESH_DELAY_MS=1000
