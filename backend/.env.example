# Copy this file to .env and fill in the values:
#
#     cp .env.example .env
#
# .env is gitignored and holds real secrets. This file is committed and holds
# only placeholders, so a fresh clone knows exactly which variables exist.

# --- Django core -----------------------------------------------------------
# REQUIRED. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-real-secret-key

# Never True in production.
DJANGO_DEBUG=True

# Comma-separated. Must include every hostname the API is served on.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# Set DB_NAME to use PostgreSQL. Leave it unset (or commented out) and the
# project falls back to a SQLite file at backend/db.sqlite3, which needs no
# setup at all.
#
# Worth knowing: select_for_update() does real row-level locking on Postgres,
# but is silently ignored by SQLite. The dispatch code is written for Postgres.
DB_NAME=fleet_dispatch
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

# --- Redis -----------------------------------------------------------------
# Same Redis server, three DB indices, one per concern.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
REDIS_CHANNEL_URL=redis://127.0.0.1:6379/2

# --- JWT -------------------------------------------------------------------
# Short access token, longer refresh token.
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# --- CORS ------------------------------------------------------------------
# Origins allowed to call this API. Vite's dev server is :5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- GPS ingestion tuning --------------------------------------------------
# How long a GPS ping stays "live" in Redis before it expires.
GPS_STATE_TTL_SECONDS=30
# Rate limit per agent: GPS_RATE_LIMIT_MAX pings per GPS_RATE_LIMIT_WINDOW seconds.
GPS_RATE_LIMIT_MAX=10
GPS_RATE_LIMIT_WINDOW=10

# --- Delivery simulation ---------------------------------------------------
# There are no real vehicles, so the Celery worker drives them: an assigned
# rider sets off, reports a position every tick, and is freed on arrival.
# Defaults run the clock at 60x -- one simulated minute per real second.
DELIVERY_START_DELAY_SECONDS=3
DELIVERY_TICK_SECONDS=1.0
DELIVERY_MINUTES_PER_STEP=1.0
